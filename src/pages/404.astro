---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page doesn’t exist on chrislawson.dev.">
	<main>
		<header class="page-header">
			<p class="eyebrow">404</p>
			<h1>Page not found</h1>
			<p class="muted">
				That URL isn’t on this site. Try the home page, or jump to writing and experience below.
			</p>
		</header>

		<p class="actions">
			<a class="primary" href="/">Home</a>
			<a href="/blog">Blog</a>
			<a href="/experience">Experience</a>
			<a href="/about">About</a>
		</p>
	</main>
</BaseLayout>
<style>
	.page-header {
		margin-bottom: 1.75rem;
	}

	.eyebrow {
		margin: 0 0 0.5rem 0;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.page-header h1 {
		margin-bottom: 0.75rem;
	}

	.page-header p {
		max-width: 34rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem 1.25rem;
		align-items: center;
	}

	.actions a {
		color: var(--text-muted);
		text-decoration: none;
		border-bottom: 1px solid transparent;
	}

	.actions a:hover {
		color: var(--accent);
		border-bottom-color: currentColor;
	}

	.actions .primary {
		display: inline-flex;
		padding: 0.65rem 1.1rem;
		background: var(--accent);
		color: var(--navy-deep);
		font-weight: 700;
		font-size: 0.95rem;
		border-bottom: none;
		border-radius: 2px;
	}

	.actions .primary:hover {
		background: var(--accent-strong);
		color: var(--navy-deep);
		border-bottom: none;
	}
</style>
