---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	ogType?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, imageAlt, ogType, publishedTime, modifiedTime, jsonLd } =
	Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			imageAlt={imageAlt}
			ogType={ogType}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
