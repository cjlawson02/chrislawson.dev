---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

function normalizePath(path: string) {
	if (!path || path === '/') return '/';
	const withLeading = path.startsWith('/') ? path : `/${path}`;
	return withLeading.length > 1 && withLeading.endsWith('/')
		? withLeading.slice(0, -1)
		: withLeading;
}

const hrefStr = typeof href === 'string' ? href : '';
const normalizedHref = normalizePath(hrefStr);
const normalizedPath = normalizePath(Astro.url.pathname);
const isActive =
	normalizedHref === normalizedPath ||
	(normalizedHref !== '/' && normalizedPath.startsWith(`${normalizedHref}/`));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}><slot /></a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
</style>
