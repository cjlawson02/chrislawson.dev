<script>
	import PhotoSwipeLightbox from 'photoswipe/lightbox';
	import type { SlideData } from 'photoswipe';
	import 'photoswipe/style.css';

	const FALLBACK_SIZE = { width: 1600, height: 1200 };

	function zoomSrc(image: HTMLImageElement): string {
		return image.dataset.zoomSrc || image.currentSrc || image.src;
	}

	async function zoomSize(image: HTMLImageElement): Promise<{ width: number; height: number }> {
		const width = Number(image.dataset.zoomWidth);
		const height = Number(image.dataset.zoomHeight);
		if (width && height) return { width, height };

		if (!image.dataset.zoomSrc && image.complete && image.naturalWidth) {
			return { width: image.naturalWidth, height: image.naturalHeight };
		}

		const probe = new Image();
		probe.src = zoomSrc(image);
		await probe.decode().catch(() => undefined);
		return probe.naturalWidth
			? { width: probe.naturalWidth, height: probe.naturalHeight }
			: FALLBACK_SIZE;
	}

	function initImageLightbox() {
		const article = document.querySelector('article');
		if (!article) return;

		const images = [...article.querySelectorAll('img')];
		if (images.length === 0) return;

		const lightbox = new PhotoSwipeLightbox({
			pswpModule: () => import('photoswipe'),
			bgOpacity: 0.92,
			showHideAnimationType: 'fade',
			loop: true,
		});
		lightbox.init();

		async function open(index: number) {
			const dataSource: SlideData[] = await Promise.all(
				images.map(async (image) => ({
					src: zoomSrc(image),
					alt: image.alt,
					element: image,
					...(await zoomSize(image)),
				})),
			);
			void lightbox.loadAndOpen(index, dataSource);
		}

		images.forEach((image, index) => {
			image.classList.add('zoomable-image');
			image.tabIndex = 0;
			image.setAttribute('role', 'button');
			image.setAttribute('aria-label', image.alt ? `Zoom image: ${image.alt}` : 'Zoom image');

			image.addEventListener('click', () => void open(index));
			image.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					void open(index);
				}
			});
		});
	}

	initImageLightbox();
</script>

<style is:global>
	.zoomable-image {
		cursor: zoom-in;
	}

	.pswp {
		--pswp-bg: #0a0c16;
		--pswp-icon-color: var(--text);
		--pswp-icon-color-secondary: var(--navy-deep);
		--pswp-icon-stroke-color: var(--navy-deep);
		--pswp-error-text-color: var(--text-muted);
	}

	.pswp__button:hover .pswp__icn,
	.pswp__button:focus-visible .pswp__icn {
		fill: var(--accent);
	}
</style>
