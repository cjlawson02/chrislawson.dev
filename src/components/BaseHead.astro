---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	imageAlt?: string;
	ogType?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image,
	imageAlt,
	ogType = 'website',
	publishedTime,
	modifiedTime,
	jsonLd,
} = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;

// Astro's image service emits dimension-specific filenames; raw image.src 404s for OG crawlers.
const ogImageAsset = image
	? await getImage({ src: image, width: 1200, height: 630, format: 'jpg' })
	: null;
const ogImage = ogImageAsset
	? new URL(ogImageAsset.src, Astro.site)
	: new URL('/og-default.jpg', Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#242943" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE_TITLE} Blog`}
	href={new URL('rss.xml', Astro.site)}
/>

<Font cssVariable="--font-body" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_TITLE} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{
	ogImageAsset && (
		<>
			<meta property="og:image:width" content={String(ogImageAsset.attributes.width)} />
			<meta property="og:image:height" content={String(ogImageAsset.attributes.height)} />
		</>
	)
}
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{
	ogType === 'article' && publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}
{
	ogType === 'article' && modifiedTime && (
		<meta property="article:modified_time" content={modifiedTime.toISOString()} />
	)
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
