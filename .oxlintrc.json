{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"env": {
		"builtin": true,
		"browser": true
	},
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"ignorePatterns": [
		"dist/**",
		"node_modules/**",
		".astro/**",
		".wrangler/**",
		"**/*.astro",
		"worker-configuration.d.ts"
	]
}
